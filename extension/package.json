{
  "name": "forge-a-thon-extension",
  "displayName": "Forge",
  "version": "0.2.0",
  "publisher": "forge-a-thon",
  "description": "Editor-native coding agent on TrueForge: automatic context assembly with a code graph, multi-file staged edits, sandboxed checks and per-hunk review.",
  "author": "Team Husttlers",
  "repository": {
    "type": "git",
    "url": "https://github.com/dash10107/iit-true-forge"
  },
  "homepage": "https://github.com/dash10107/iit-true-forge#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forge.inlineEdit",
        "title": "Forge: Inline Edit Selection",
        "icon": "$(sparkle)"
      },
      {
        "command": "forge.focus",
        "title": "Forge: Open Agent"
      },
      {
        "command": "forge.stop",
        "title": "Forge: Stop Current Run"
      },
      {
        "command": "forge.undoLastApply",
        "title": "Forge: Undo Last Applied Change"
      },
      {
        "command": "forge.environmentStatus",
        "title": "Forge: Environment Status"
      },
      {
        "command": "forge.hunkAccept",
        "title": "Forge: Accept Hunk",
        "icon": "$(check)"
      },
      {
        "command": "forge.hunkReject",
        "title": "Forge: Reject Hunk",
        "icon": "$(close)"
      },
      {
        "command": "forge.reviewApply",
        "title": "Forge: Apply Accepted Hunks",
        "icon": "$(check-all)"
      },
      {
        "command": "forge.reviewRejectAll",
        "title": "Forge: Reject All Hunks",
        "icon": "$(discard)"
      }
    ],
    "keybindings": [
      {
        "command": "forge.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "forge.stop",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "!inQuickOpen"
      },
      {
        "command": "forge.hunkAccept",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "resourceScheme == forge-review"
      },
      {
        "command": "forge.hunkReject",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "resourceScheme == forge-review"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "forge.inlineEdit",
          "when": "editorTextFocus",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "forge.reviewApply",
          "when": "resourceScheme == forge-review",
          "group": "navigation@1"
        },
        {
          "command": "forge.reviewRejectAll",
          "when": "resourceScheme == forge-review",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "forge.hunkAccept",
          "when": "resourceScheme == forge-review"
        },
        {
          "command": "forge.hunkReject",
          "when": "resourceScheme == forge-review"
        },
        {
          "command": "forge.reviewApply",
          "when": "resourceScheme == forge-review"
        },
        {
          "command": "forge.reviewRejectAll",
          "when": "resourceScheme == forge-review"
        }
      ]
    },
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.trueforgeBaseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "TrueForge server URL. Models and API keys are configured in TrueForge, never in Forge."
        },
        "forge.fallbackModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Ordered TrueForge model names to switch to automatically when the selected model fails (network, credentials, quota, overload). Only listed models are ever used."
        },
        "forge.maxModelSwitches": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "Maximum automatic model switches per run."
        },
        "forge.maxModelCalls": {
          "type": "integer",
          "default": 40,
          "minimum": 4,
          "maximum": 200,
          "description": "Hard cap on model calls per agent run; staged edits are offered for review when it is reached."
        },
        "forge.tightBudgetProviders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "groq"
          ],
          "description": "Provider prefixes with strict per-minute token limits; they get a compact context profile."
        },
        "forge.contextBudget": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 60000,
          "description": "Estimated tokens for the automatic context pack (0 = profile default: 2.2k tight, 7k standard)."
        },
        "forge.maxToolResultChars": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 60000,
          "description": "Character cap per tool result (0 = profile default)."
        },
        "forge.maxOutputTokens": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 64000,
          "description": "Model output token limit (0 = profile default)."
        },
        "forge.compactionThreshold": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 1000000,
          "description": "Input tokens at which TrueForge compacts the conversation (0 = profile default)."
        },
        "forge.reasoningEffort": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "none",
            "minimal",
            "low",
            "medium",
            "high"
          ],
          "description": "Optional reasoning effort passed to models that support it."
        },
        "forge.repoMap": {
          "type": "boolean",
          "default": true,
          "description": "Use the RepoMap code graph for symbol ranking and the find_symbol tool."
        },
        "forge.codeMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable TrueForge's sandbox/Code Mode. Adds ~1.8k harness tokens per request; useful for large-quota models."
        },
        "forge.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "python",
            "python3",
            "pytest",
            "flask",
            "node",
            "npm"
          ],
          "description": "Executables the agent may run (in a disposable snapshot with staged edits)."
        },
        "forge.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter for run_command (defaults to .venv/bin/python in the workspace)."
        },
        "forge.commandTimeoutSeconds": {
          "type": "integer",
          "default": 120,
          "minimum": 5,
          "maximum": 600,
          "description": "Timeout for one run_command."
        },
        "forge.sandboxCommands": {
          "type": "boolean",
          "default": true,
          "description": "On macOS, run commands under sandbox-exec with network and outside writes denied."
        },
        "forge.autoVerify": {
          "type": "boolean",
          "default": true,
          "description": "After each stage_edits, run the relevant tests in a sandboxed snapshot automatically (no extra model call) and report the result to the agent and the review card."
        },
        "forge.verifyCommand": {
          "type": "string",
          "default": "",
          "description": "Optional verification command; {tests} is replaced by the inferred test files (default for Python: python -m pytest {tests} -q)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge",
          "title": "Forge",
          "icon": "media/forge.svg"
        }
      ]
    },
    "views": {
      "forge": [
        {
          "id": "forge.sidebar",
          "name": "Agent",
          "type": "webview"
        }
      ]
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check-types": "tsc --noEmit -p ./",
    "test": "npm run compile && vscode-test",
    "test:unit": "npm run compile && node --test scripts/*.test.cjs",
    "trueforge:models": "node scripts/list-trueforge-models.mjs",
    "agent:live": "npm run compile && node scripts/agent-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sylphx/repomap": "1.9.0",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.9.3"
  }
}
