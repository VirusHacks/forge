<!doctype html>
<html lang="en" data-resolution="landscape">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { margin: 0; width: 1920px; height: 1080px; overflow: hidden; background: #0a0d13; }
      #root { position: relative; width: 100%; height: 100%; font-family: Inter, sans-serif; }
      #bg { position: absolute; inset: 0; background: #0a0d13; }
      .wrap { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; overflow: hidden; }
      .wrap video { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; object-fit: contain; }
    </style>
  </head>
  <body>
    <!--
      Forge · Forge-a-thon demo. All footage under assets/clips is real VS Code capture (see ../CAPTURE_PLAN.md);
      overlays only point at what is already on screen.
      Timeline (s): intro 0–12 · architecture 12–35.0 · Task A 35.0–73.8 · Task B 73.8–172.4 · Task C 172.4–216.0 · recap 216.0–236.0
    -->
    <div id="root" data-composition-id="main" data-start="0" data-duration="236.0" data-width="1920" data-height="1080">
      <div id="bg"></div>
      <div id="intro" data-composition-id="intro" data-composition-src="compositions/intro.html" data-start="0" data-duration="12" data-track-index="1" data-track-kind="graphics" data-width="1920" data-height="1080"></div>
      <div id="arch" data-composition-id="arch" data-composition-src="compositions/arch.html" data-start="12" data-duration="23.0" data-track-index="1" data-track-kind="graphics" data-width="1920" data-height="1080"></div>

      <div id="wrapA" class="wrap" style="z-index:2"><video id="vidA" class="clip" src="assets/clips/taskA.mp4" muted playsinline data-start="35.0" data-duration="38.8" data-track-index="2"></video></div>
      <div id="wrapB" class="wrap" style="z-index:2"><video id="vidB" class="clip" src="assets/clips/taskB.mp4" muted playsinline data-start="73.8" data-duration="98.6" data-track-index="2"></video></div>
      <div id="wrapC" class="wrap" style="z-index:2"><video id="vidC" class="clip" src="assets/clips/taskC.mp4" muted playsinline data-start="172.4" data-duration="43.6" data-track-index="2"></video></div>

      <div id="ovA" data-composition-id="ovA" data-composition-src="compositions/ovA.html" data-start="35.0" data-duration="38.8" data-track-index="3" data-track-kind="graphics" data-width="1920" data-height="1080" style="z-index:5"></div>
      <div id="ovB" data-composition-id="ovB" data-composition-src="compositions/ovB.html" data-start="73.8" data-duration="98.6" data-track-index="3" data-track-kind="graphics" data-width="1920" data-height="1080" style="z-index:5"></div>
      <div id="ovC" data-composition-id="ovC" data-composition-src="compositions/ovC.html" data-start="172.4" data-duration="43.6" data-track-index="3" data-track-kind="graphics" data-width="1920" data-height="1080" style="z-index:5"></div>

      <div id="recap" data-composition-id="recap" data-composition-src="compositions/recap.html" data-start="216.0" data-duration="20.0" data-track-index="1" data-track-kind="graphics" data-width="1920" data-height="1080" style="z-index:6"></div>

      <!-- Narration (Kokoro af_heart, generated locally) -->
      <audio id="n-s1" class="clip" src="assets/audio/s1_intro.wav" data-start="0.40" data-duration="11.520" data-track-index="10" data-volume="1"></audio>
      <audio id="n-s2" class="clip" src="assets/audio/s2_arch.wav" data-start="12.20" data-duration="21.781" data-track-index="10" data-volume="1"></audio>
      <audio id="n-a1" class="clip" src="assets/audio/a1.wav" data-start="35.30" data-duration="9.173" data-track-index="10" data-volume="1"></audio>
      <audio id="n-a2" class="clip" src="assets/audio/a2.wav" data-start="45.00" data-duration="14.059" data-track-index="10" data-volume="1"></audio>
      <audio id="n-a3" class="clip" src="assets/audio/a3.wav" data-start="62.60" data-duration="8.725" data-track-index="10" data-volume="1"></audio>
      <audio id="n-b1" class="clip" src="assets/audio/b1.wav" data-start="74.10" data-duration="6.656" data-track-index="10" data-volume="1"></audio>
      <audio id="n-b2" class="clip" src="assets/audio/b2.wav" data-start="81.20" data-duration="16.171" data-track-index="10" data-volume="1"></audio>
      <audio id="n-b3" class="clip" src="assets/audio/b3.wav" data-start="97.60" data-duration="13.909" data-track-index="10" data-volume="1"></audio>
      <audio id="n-b4" class="clip" src="assets/audio/b4.wav" data-start="111.70" data-duration="3.648" data-track-index="10" data-volume="1"></audio>
      <audio id="n-b4b" class="clip" src="assets/audio/b4b.wav" data-start="116.20" data-duration="5.952" data-track-index="10" data-volume="1"></audio>
      <audio id="n-b5" class="clip" src="assets/audio/b5.wav" data-start="122.20" data-duration="3.243" data-track-index="10" data-volume="1"></audio>
      <audio id="n-b6" class="clip" src="assets/audio/b6.wav" data-start="131.70" data-duration="2.624" data-track-index="10" data-volume="1"></audio>
      <audio id="n-b7" class="clip" src="assets/audio/b7.wav" data-start="138.70" data-duration="7.680" data-track-index="10" data-volume="1"></audio>
      <audio id="n-b8" class="clip" src="assets/audio/b8.wav" data-start="149.20" data-duration="3.029" data-track-index="10" data-volume="1"></audio>
      <audio id="n-b9" class="clip" src="assets/audio/b9.wav" data-start="155.40" data-duration="6.123" data-track-index="10" data-volume="1"></audio>
      <audio id="n-b10" class="clip" src="assets/audio/b10.wav" data-start="163.80" data-duration="7.787" data-track-index="10" data-volume="1"></audio>
      <audio id="n-c1" class="clip" src="assets/audio/c1.wav" data-start="172.70" data-duration="11.093" data-track-index="10" data-volume="1"></audio>
      <audio id="n-c2" class="clip" src="assets/audio/c2.wav" data-start="186.00" data-duration="10.901" data-track-index="10" data-volume="1"></audio>
      <audio id="n-c3a" class="clip" src="assets/audio/c3a.wav" data-start="201.00" data-duration="1.365" data-track-index="10" data-volume="1"></audio>
      <audio id="n-c3b" class="clip" src="assets/audio/c3b.wav" data-start="207.40" data-duration="4.757" data-track-index="10" data-volume="1"></audio>
      <audio id="n-s6" class="clip" src="assets/audio/s6_recap.wav" data-start="216.20" data-duration="19.733" data-track-index="10" data-volume="1"></audio>

      <!-- Music bed (synthesised with FFmpeg) and sparse sound design (CC sfx, see assets/sfx/CREDITS.md) -->
      <audio id="music" class="clip" src="assets/audio/music_bed.wav" data-start="0" data-duration="236.0" data-track-index="11" data-volume="2.2" data-fade-in="2" data-fade-out="4"></audio>
      <audio id="sfx-w1" class="clip" src="assets/sfx/whoosh-short.mp3" data-start="11.80" data-duration="0.575" data-track-index="12" data-volume="0.35"></audio>
      <audio id="sfx-w2" class="clip" src="assets/sfx/whoosh-short.mp3" data-start="34.80" data-duration="0.575" data-track-index="12" data-volume="0.35"></audio>
      <audio id="sfx-w3" class="clip" src="assets/sfx/whoosh-short.mp3" data-start="73.60" data-duration="0.575" data-track-index="12" data-volume="0.35"></audio>
      <audio id="sfx-w4" class="clip" src="assets/sfx/whoosh-short.mp3" data-start="172.20" data-duration="0.575" data-track-index="12" data-volume="0.35"></audio>
      <audio id="sfx-w5" class="clip" src="assets/sfx/whoosh-short.mp3" data-start="215.80" data-duration="0.575" data-track-index="12" data-volume="0.35"></audio>
      <audio id="sfx-c1" class="clip" src="assets/sfx/click-soft.mp3" data-start="56.20" data-duration="0.366" data-track-index="12" data-volume="0.5"></audio>
      <audio id="sfx-c2" class="clip" src="assets/sfx/click-soft.mp3" data-start="122.25" data-duration="0.366" data-track-index="12" data-volume="0.5"></audio>
      <audio id="sfx-c3" class="clip" src="assets/sfx/click-soft.mp3" data-start="200.90" data-duration="0.366" data-track-index="12" data-volume="0.5"></audio>
      <audio id="sfx-k1" class="clip" src="assets/sfx/chime.mp3" data-start="63.90" data-duration="2.500" data-track-index="12" data-volume="0.22"></audio>
      <audio id="sfx-k2" class="clip" src="assets/sfx/chime.mp3" data-start="131.70" data-duration="2.500" data-track-index="12" data-volume="0.22"></audio>
      <audio id="sfx-k3" class="clip" src="assets/sfx/chime.mp3" data-start="211.50" data-duration="2.500" data-track-index="12" data-volume="0.22"></audio>
    </div>
    <script>
      const tl = gsap.timeline({ paused: true });
      const zoom = (sel, at, scale, ox, oy, dur = 0.9) =>
        tl.to(sel, { scale, transformOrigin: `${ox}px ${oy}px`, duration: dur, ease: "power2.inOut" }, at);
      tl.set(["#wrapA", "#wrapB", "#wrapC"], { scale: 1, transformOrigin: "960px 540px" }, 0);
      zoom("#wrapA", 35.0 + 27.1, 1.7, 1065, 900);
      zoom("#wrapB", 73.8 + 53.0, 1.6, 900, 840);
      tl.set("#wrapB", { scale: 1.5, transformOrigin: "650px 720px" }, 73.8 + 73.21);
      tl.set("#wrapB", { scale: 1.6, transformOrigin: "900px 840px" }, 73.8 + 80.21);
      tl.set("#wrapB", { scale: 1, transformOrigin: "960px 540px" }, 73.8 + 89.96);
      zoom("#wrapC", 172.4 + 34.0, 1.8, 900, 840);
      [["#wrapA", 35.0, 73.8], ["#wrapB", 73.8, 172.4], ["#wrapC", 172.4, 216.0]].forEach(([s, a, b]) => {
        tl.fromTo(s, { opacity: 0 }, { opacity: 1, duration: 0.35 }, a);
        tl.to(s, { opacity: 0, duration: 0.3 }, b - 0.3);
      });
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
