+@click.command("config", short_help="Show the app configuration as JSON.")
+@with_appcontext
+def config_command() -> None:
+    """Show configuration, masking sensitive values."""
+    sensitive = ("SECRET", "PASSWORD", "TOKEN", "KEY")
+    values = {
+        key: "***" if any(part in key.upper() for part in sensitive) else value
+        for key, value in current_app.config.items()
+    }
+    click.echo(json.dumps(values, default=str))
+
