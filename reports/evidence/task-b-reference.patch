+def test_config_command_masks_sensitive_values(app, runner):
+    app.config.update(PUBLIC_VALUE="visible", SECRET_VALUE="secret", DB_PASSWORD="pw", API_TOKEN="tok", API_KEY="key")
+    result = runner.invoke(FlaskGroup(create_app=lambda: app), ["config"])
+    assert result.exit_code == 0, result.output
+    values = json.loads(result.output)
+    assert values["PUBLIC_VALUE"] == "visible"
+    for key in ("SECRET_VALUE", "DB_PASSWORD", "API_TOKEN", "API_KEY"):
+        assert values[key] == "***"
+    help_result = runner.invoke(FlaskGroup(create_app=lambda: app), ["--help"])
+    assert "config" in help_result.output
